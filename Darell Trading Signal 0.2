data:text/html;charset=utf-8,<!DOCTYPE html><html><head><meta name=viewport content="width=device-width,initial-scale=1"><title>BOSS PRO</title><script src=https://cdn.jsdelivr.net/npm/chart.js></script><style>body{background:%230a0a0a;color:%23fff;font-family:Arial;padding:10px}.card{background:%23222;border-radius:12px;padding:12px;margin:8px 0}button{background:%2300d395;color:%23000;border:none;padding:10px;border-radius:8px;width:100%;font-weight:bold}input{width:100%25;padding:10px;border-radius:8px;background:%23333;color:%23fff;border:none;margin:4px 0}</style></head><body><h2>🔥 BOSS PRO V3 - LIVE</h2><div class=card><p>BTC $67,420->70k | ETH $2710->3k | SOL $121->128 | BNB $775->800 | GOLD $2685->2700</p><canvas id=c height=150></canvas></div><div class=card><h3>Calculator</h3><input id=b value=0.4366 placeholder=Balance><input id=e value=1.55 placeholder=Entry><input id=m value=1.27 placeholder=Mark><input id=s value=128 placeholder=Strike><input id=t value=128 placeholder=Target><button onclick="let b=+document.getElementById('b').value,e=+document.getElementById('e').value,m=+document.getElementById('m').value,s=+document.getElementById('s').value,t=+document.getElementById('t').value,p=m-e,be=s+e,pr=t-be;document.getElementById('r').innerHTML=`P&L: $${p.toFixed(4)} | BE: $${be} | Profit: $${pr.toFixed(2)} ${pr>=0?'✅BUY':'❌SKIP'}`">CALCULATE</button><p id=r></p></div><script>new Chart(document.getElementById('c'),{type:'line',data:{labels:['23','24','25','26','27','28'],datasets:[{label:'SOL',data:[110,115,121.4,125,128,130],borderColor:'%239945FF'},{label:'BNB',data:[750,760,775,785,800,810],borderColor:'%23F3BA2F'}]},options:{plugins:{legend:{labels:{color:'%23fff'}}}}})</script></body></html>
